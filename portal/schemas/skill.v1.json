{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.internal/schemas/skill.v1.json",
  "title": "skill/v1",
  "description": "skills/<name>/skill.yaml in the platform's golden-road-skills catalog: which environments may mount the skill and who may pick it. Security approves each by pull request (CODEOWNERS on skills/).",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "name", "description", "environments", "audience"],
  "$defs": {"single_line": {"not": {"pattern": "[\\r\\n]"}}},
  "properties": {
    "schema": {"const": "skill/v1"},
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$", "allOf": [{"$ref": "#/$defs/single_line"}]},
    "description": {"type": "string", "minLength": 1, "maxLength": 300, "pattern": "^[^\\u0000-\\u001f\\u007f]+$", "allOf": [{"$ref": "#/$defs/single_line"}]},
    "environments": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["test", "prod"]}},
    "audience": {"oneOf": [{"const": "everyone"},
                           {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true,
                            "items": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001f\\u007f]+$", "allOf": [{"$ref": "#/$defs/single_line"}]}}]}
  }
}
