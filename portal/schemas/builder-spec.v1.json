{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.internal/schemas/builder-spec.v1.json",
  "title": "builder-spec/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["app_name", "app_type", "entrypoint", "port", "data_classification", "egress", "env", "resources_tier"],
  "$defs": {"single_line": {"not": {"pattern": "[\\r\\n]"}}},
  "properties": {
    "app_name": {"type": "string", "pattern": "^[a-z]([a-z0-9-]{0,40}[a-z0-9])?$", "allOf": [{"$ref": "#/$defs/single_line"}]},
    "app_type": {"enum": ["python", "node", "static"]},
    "entrypoint": {"type": "string", "pattern": "^[A-Za-z0-9_.][A-Za-z0-9_./:-]*$", "allOf": [{"$ref": "#/$defs/single_line"}, {"not": {"pattern": "(^|/)\\.\\.(/|:|$)"}}]},
    "server": {"enum": ["uvicorn", "gunicorn"]},
    "port": {"type": "integer", "minimum": 1024, "maximum": 65535},
    "health_path": {"type": "string", "pattern": "^/[A-Za-z0-9_./-]*$", "allOf": [{"$ref": "#/$defs/single_line"}]},
    "data_classification": {"enum": ["public", "internal", "restricted", "phi"]},
    "egress": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["host", "port", "reason"],
        "properties": {
          "host": {"type": "string", "maxLength": 253, "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*\\.[a-z]([a-z0-9-]*[a-z0-9])?$", "allOf": [{"$ref": "#/$defs/single_line"}]},
          "port": {"type": "integer", "minimum": 1, "maximum": 65535},
          "reason": {"type": "string", "minLength": 3, "allOf": [{"$ref": "#/$defs/single_line"}]}
        }
      }
    },
    "env": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "secret"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$", "allOf": [{"$ref": "#/$defs/single_line"}]},
          "secret": {"type": "boolean"}
        }
      }
    },
    "resources_tier": {"enum": ["default", "medium"]},
    "authz": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roles", "default", "rules"],
      "properties": {
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "access"],
            "properties": {
              "name": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$", "allOf": [{"$ref": "#/$defs/single_line"}]},
              "access": {"enum": ["read", "write"]}
            }
          }
        },
        "default": {"const": "deny"},
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["methods", "path", "roles"],
            "properties": {
              "methods": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]}},
              "path": {"type": "string", "pattern": "^/[A-Za-z0-9_./*{}-]*$", "allOf": [{"$ref": "#/$defs/single_line"}]},
              "roles": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$", "allOf": [{"$ref": "#/$defs/single_line"}]}},
              "justification": {"type": "string", "minLength": 10, "allOf": [{"$ref": "#/$defs/single_line"}]}
            }
          }
        }
      }
    }
  }
}
