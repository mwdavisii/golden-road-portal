# Generated by builder. Keeps local state and secrets out of the image.
# Secrets and junk are matched at any depth; builder-owned and VCS paths only at the context root.
.git
.github
.venv
venv
**/node_modules
**/__pycache__
**/*.pyc
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/id_rsa*
**/.npmrc
**/.pypirc
**/.netrc
**/.aws
**/.ssh
**/secrets
deploy
Dockerfile
.dockerignore
builder-spec.json
.builder.lock
