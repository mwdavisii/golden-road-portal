{
  "app_name": "golden-road-portal",
  "app_type": "python",
  "authz": {
    "default": "deny",
    "roles": [
      {
        "access": "write",
        "name": "portal"
      }
    ],
    "rules": [
      {
        "methods": [
          "DELETE",
          "GET",
          "PATCH",
          "POST",
          "PUT"
        ],
        "path": "/**",
        "roles": [
          "portal"
        ]
      }
    ]
  },
  "data_classification": "confidential",
  "egress": [
    {
      "host": "api.github.com",
      "port": 443,
      "reason": "GitHub API: identity linking"
    },
    {
      "host": "github.com",
      "port": 443,
      "reason": "GitHub OAuth: identity linking"
    }
  ],
  "entrypoint": "portal.main:app",
  "env": [
    {
      "name": "PORTAL_BASE_URL",
      "secret": false
    },
    {
      "name": "PORTAL_ORG",
      "secret": false
    },
    {
      "name": "PORTAL_GITHUB_HOST",
      "secret": false
    },
    {
      "name": "PORTAL_OIDC_ISSUER",
      "secret": false
    },
    {
      "name": "PORTAL_OIDC_CLIENT_ID",
      "secret": false
    },
    {
      "name": "PORTAL_OIDC_CLIENT_SECRET",
      "secret": true
    },
    {
      "name": "PORTAL_ROLE_GROUPS",
      "secret": false
    },
    {
      "name": "PORTAL_GITHUB_OAUTH_CLIENT_ID",
      "secret": false
    },
    {
      "name": "PORTAL_GITHUB_OAUTH_CLIENT_SECRET",
      "secret": true
    },
    {
      "name": "PORTAL_DATABASE_URL",
      "secret": true
    },
    {
      "name": "PORTAL_DIRECTORY",
      "secret": false
    },
    {
      "name": "PORTAL_IDENTITY_PROCESS_URL",
      "secret": false
    },
    {
      "name": "PORTAL_DATA_PROCESS_URL",
      "secret": false
    },
    {
      "name": "PORTAL_SECRET_SERVER",
      "secret": false
    },
    {
      "name": "PORTAL_SECRET_PROCESS_URL",
      "secret": false
    },
    {
      "name": "PORTAL_CLASSIFICATION_POLICY_URL",
      "secret": false
    },
    {
      "name": "PORTAL_REPO_ADMINS_STALE_AFTER",
      "secret": false
    },
    {
      "name": "PORTAL_REREVIEW_STALE_DAYS",
      "secret": false
    }
  ],
  "health_path": "/healthz",
  "port": 8080,
  "resources_tier": "default",
  "server": "uvicorn"
}
